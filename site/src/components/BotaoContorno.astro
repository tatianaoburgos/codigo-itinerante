---
interface Props {
  href: string;
  /** Link externo (padrão): abre em nova aba. Desligue para links internos do site. */
  externo?: boolean;
}

const { href, externo = true } = Astro.props;
---

<a
  href={href}
  target={externo ? "_blank" : undefined}
  rel={externo ? "noopener" : undefined}
  class="inline-block rounded-full border border-ambar px-6 py-2.5 font-medium text-ambar transition-colors hover:bg-ambar hover:text-breu"
>
  <slot />
</a>
