---
import type { Acomodacao } from '../lib/schema';
import { config } from '../lib/cliente';
import Galeria from './Galeria.astro';

interface Props {
  acomodacao: Acomodacao;
}

const { acomodacao } = Astro.props;

const textoPreco =
  config.precos.politica === 'faixa' && config.precos.faixa
    ? config.precos.faixa
    : 'Consulte valores pelo WhatsApp';
---

<article class="grid gap-6 rounded-xl bg-white p-5 shadow-sm sm:grid-cols-2">
  <Galeria fotos={acomodacao.fotos} />
  <div>
    <p class="font-mono text-xs tracking-widest text-azulejo uppercase">{acomodacao.capacidade}</p>
    <h3 class="mt-1 font-display text-2xl font-bold text-mare">{acomodacao.nome}</h3>
    <ul class="mt-4 space-y-1.5 text-sm">
      {
        acomodacao.comodidades.map((comodidade) => (
          <li class="flex gap-2">
            <span class="mt-2 h-0.5 w-3 shrink-0 bg-fitinha" aria-hidden="true" />
            {comodidade}
          </li>
        ))
      }
    </ul>
    <p class="mt-5 text-sm font-bold">{textoPreco}</p>
  </div>
</article>
