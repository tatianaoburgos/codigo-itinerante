---
import { simboloMarca } from '../lib/fotos';

const simbolo = simboloMarca();
---

{/* SVG vetorial: `<img>` cru é intencional — astro:assets otimiza raster, não SVG. */}
<div class="flex justify-center py-2" aria-hidden="true">
  {
    simbolo ? (
      <img src={simbolo.src} alt="" class="h-8 w-auto opacity-70" />
    ) : (
      <span class="h-0.5 w-10 bg-fitinha" />
    )
  }
</div>
