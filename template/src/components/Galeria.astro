---
import { Image } from 'astro:assets';
import type { Foto } from '../lib/schema';
import { foto } from '../lib/fotos';

interface Props {
  fotos: Foto[];
}

const { fotos } = Astro.props;
---

<div class:list={['grid gap-2', fotos.length > 1 ? 'grid-cols-2' : 'grid-cols-1']}>
  {
    fotos.map((f) => (
      <Image
        src={foto(f.arquivo)}
        alt={f.alt}
        widths={[400, 800]}
        sizes="(min-width: 640px) 440px, 100vw"
        class="h-full w-full rounded-lg object-cover"
      />
    ))
  }
</div>
