---
import { Image } from 'astro:assets';
import { config } from '../lib/cliente';
import { foto, marca, simboloMarca, video } from '../lib/fotos';
import MarcaDagua from './MarcaDagua.astro';

const logo = config.marca?.logo && !config.marca.logoApenasNoMenu ? marca(config.marca.logo) : undefined;
const heroVideo = config.marca?.heroVideo ? video(config.marca.heroVideo) : undefined;
const heroVideoPoster = config.marca?.heroVideoPoster
  ? foto(config.marca.heroVideoPoster)
  : undefined;
const heroCentralizado = config.marca?.heroCentralizado ?? false;
const simbolo = heroCentralizado ? simboloMarca() : undefined;
const fraseHero = config.marca?.heroFraseQuebrada ?? config.slogan;
---

<section id="hero" class="relative isolate flex min-h-svh items-end overflow-hidden bg-noite">
  {!heroCentralizado && <MarcaDagua />}
  {
    heroVideo ? (
      <>
        {heroVideoPoster && (
          <Image
            src={heroVideoPoster}
            alt=""
            widths={[640, 1024, 1600]}
            sizes="100vw"
            loading="eager"
            class="absolute inset-0 -z-10 h-full w-full object-cover object-[50%_42%]"
          />
        )}
        <video
          class="hero-video absolute inset-0 -z-10 hidden h-full w-full object-cover object-[50%_42%]"
          data-src={heroVideo}
          muted
          playsinline
        />
      </>
    ) : (
      <Image
        src={foto('capa.jpg')}
        alt=""
        widths={[640, 1024, 1600]}
        sizes="100vw"
        loading="eager"
        class="absolute inset-0 -z-10 h-full w-full object-cover"
      />
    )
  }
  <div
    class="absolute inset-0 -z-10 bg-gradient-to-t from-noite/90 via-noite/50 to-noite/20"
    aria-hidden="true"
  >
  </div>
  {
    heroCentralizado ? (
      <>
        <div class="absolute inset-0 flex items-center justify-center px-4 text-center">
          <h1 class="max-w-[12ch] font-display text-4xl font-bold text-white [text-shadow:0_2px_24px_rgba(0,0,0,0.55)] sm:text-6xl md:text-7xl">
            {config.nome}
          </h1>
        </div>
        <div class="absolute right-4 bottom-0 flex flex-col items-end gap-2 sm:right-8 md:right-12">
          <p class="hero-frase whitespace-pre-line text-right text-base font-bold text-white sm:text-lg md:text-xl">
            {fraseHero}
          </p>
          {simbolo && <img src={simbolo.src} alt="" class="h-12 w-auto sm:h-14 md:h-20" />}
        </div>
      </>
    ) : (
      <div class="mx-auto w-full max-w-5xl px-4 pt-32 pb-6 sm:pb-8">
        <h1 class="max-w-2xl">
          {/* SVG vetorial: `<img>` cru é intencional — astro:assets otimiza raster, não SVG. */}
          {
            logo ? (
              <img src={logo.src} alt={config.nome} class="h-14 w-auto sm:h-20" />
            ) : (
              <span class="font-display text-4xl font-bold text-white sm:text-6xl">{config.nome}</span>
            )
          }
        </h1>
        <p class="hero-frase mt-4 max-w-xl text-lg text-white">{config.slogan}</p>
      </div>
    )
  }
</section>

{
  heroVideo && (
    <script>
      const video = document.querySelector<HTMLVideoElement>('.hero-video');
      if (video && window.matchMedia('(prefers-reduced-motion: no-preference)').matches) {
        video.src = video.dataset.src!;
        video.classList.remove('hidden');
        video.play().catch(() => {});
        video.addEventListener(
          'ended',
          () => {
            video.currentTime = 0;
            video.play().catch(() => {});
          },
          { once: true },
        );
      }
    </script>
  )
}
