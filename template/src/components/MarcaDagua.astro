---
import { simboloMarca } from '../lib/fotos';

const simbolo = simboloMarca();
---

{/* SVG vetorial: `<img>` cru é intencional — astro:assets otimiza raster, não SVG. */}
{
  simbolo && (
    <img
      src={simbolo.src}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute -right-16 -bottom-16 -z-10 h-[60%] w-auto opacity-10 select-none"
    />
  )
}
