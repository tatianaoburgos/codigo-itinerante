---
import { config } from '../lib/cliente';
import BotaoWhatsApp from './BotaoWhatsApp.astro';

const abas = [
  { href: '/acomodacoes', rotulo: 'Acomodações' },
  { href: '/sobre', rotulo: 'Sobre' },
  { href: '/localizacao', rotulo: 'Localização' },
];

const caminhoAtual = Astro.url.pathname.replace(/\/$/, '') || '/';
---

<header class="border-b border-sal bg-espuma">
  <nav
    aria-label="Principal"
    class="mx-auto flex max-w-5xl flex-col items-center gap-3 px-4 py-4 sm:flex-row sm:justify-between"
  >
    <a
      href="/"
      class="font-display text-xl font-bold text-mare focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azulejo"
    >
      {config.nome}
    </a>
    <div class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2">
      {
        abas.map((aba) => (
          <a
            href={aba.href}
            aria-current={caminhoAtual === aba.href ? 'page' : undefined}
            class:list={[
              'border-b-2 pb-0.5 text-sm font-bold text-noite transition hover:text-azulejo focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azulejo',
              caminhoAtual === aba.href ? 'border-fitinha' : 'border-transparent',
            ]}
          >
            {aba.rotulo}
          </a>
        ))
      }
      <BotaoWhatsApp />
    </div>
  </nav>
</header>
