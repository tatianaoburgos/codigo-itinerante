---
import { Image } from 'astro:assets';
import { config } from '../lib/cliente';
import { foto } from '../lib/fotos';
import { aspectMosaico } from '../lib/mosaico';
---

{/* Mesma gramática do mosaico da região: no celular 2 colunas com alturas
    variadas; no computador fileiras alinhadas na mesma altura, alternando
    foto grande + pequena (display:grid desativa as columns no lg). */}
{
  config.vibe && (
    <div class="columns-2 gap-3 lg:grid lg:grid-cols-3 lg:gap-4">
      {config.vibe.map((imagem, indice) => (
        <div class:list={[
          'mb-3 overflow-hidden break-inside-avoid lg:mb-0',
          indice % 5 === 0 && 'lg:col-span-2',
        ]}>
          <Image
            src={foto(imagem.arquivo)}
            alt={imagem.alt}
            widths={[300, 600, 1200]}
            sizes="(min-width: 1024px) 40vw, 50vw"
            class:list={['w-full object-cover lg:aspect-auto lg:h-72', aspectMosaico(indice)]}
          />
        </div>
      ))}
    </div>
  )
}
