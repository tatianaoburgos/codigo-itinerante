---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { config } from '../lib/cliente';
import { marca } from '../lib/fotos';

interface Props {
  titulo?: string;
  descricao?: string;
}

const { titulo, descricao = config.descricaoSeo } = Astro.props;
const tituloPagina = titulo ? `${titulo} — ${config.nome}` : `${config.nome} — ${config.slogan}`;
const favicon = config.marca?.favicon ? marca(config.marca.favicon).src : '/favicon.svg';

const dadosEstruturados = {
  '@context': 'https://schema.org',
  '@type': 'LodgingBusiness',
  name: config.nome,
  description: config.descricaoSeo,
  address: config.localizacao.endereco,
  telephone: `+${config.contato.whatsapp}`,
  email: config.contato.email,
};
---

<!doctype html>
<html lang="pt-BR" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={favicon} />
    <title>{tituloPagina}</title>
    <meta name="description" content={descricao} />
    <script type="application/ld+json" set:html={JSON.stringify(dadosEstruturados)} />
  </head>
  <body class="flex min-h-screen flex-col bg-espuma font-corpo text-noite">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
