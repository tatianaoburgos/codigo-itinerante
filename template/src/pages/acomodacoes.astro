---
import Layout from '../layouts/Layout.astro';
import TituloSecao from '../components/TituloSecao.astro';
import CardAcomodacao from '../components/CardAcomodacao.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { config } from '../lib/cliente';
---

<Layout titulo="Acomodações">
  <section class="mx-auto max-w-5xl px-4 py-14">
    <TituloSecao eyebrow="Acomodações">Escolha seu canto</TituloSecao>
    <div class="mt-8 space-y-6">
      {config.acomodacoes.map((acomodacao) => <CardAcomodacao acomodacao={acomodacao} />)}
    </div>
    <div class="mt-10 text-center">
      <BotaoWhatsApp tamanho="grande" rotulo="Consultar disponibilidade no WhatsApp" />
    </div>
  </section>
</Layout>
