---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TituloSecao from '../components/TituloSecao.astro';
import BotaoWhatsApp from '../components/BotaoWhatsApp.astro';
import { config } from '../lib/cliente';
import { foto } from '../lib/fotos';
---

<Layout>
  <Hero />

  <section class="mx-auto max-w-5xl px-4 py-14">
    <TituloSecao eyebrow="Acomodações">Escolha seu canto</TituloSecao>
    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      {
        config.acomodacoes.map((acomodacao) => (
          <a
            href="/acomodacoes"
            class="group rounded-xl bg-white shadow-sm transition hover:shadow-md focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azulejo"
          >
            <Image
              src={foto(acomodacao.fotos[0].arquivo)}
              alt={acomodacao.fotos[0].alt}
              widths={[400, 800]}
              sizes="(min-width: 640px) 310px, 100vw"
              class="aspect-4/3 w-full rounded-t-xl object-cover"
            />
            <div class="p-4">
              <p class="font-mono text-xs tracking-widest text-azulejo uppercase">
                {acomodacao.capacidade}
              </p>
              <h3 class="mt-1 font-display text-lg font-bold text-mare group-hover:text-azulejo">
                {acomodacao.nome}
              </h3>
            </div>
          </a>
        ))
      }
    </div>
    <p class="mt-8">
      <a
        href="/acomodacoes"
        class="font-bold text-azulejo underline decoration-fitinha decoration-2 underline-offset-4 hover:text-mare focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-azulejo"
      >
        Ver todas as acomodações
      </a>
    </p>
  </section>

  <section class="bg-mare">
    <div class="mx-auto max-w-5xl px-4 py-14">
      <TituloSecao eyebrow="Atividades" claro>A vida por aqui</TituloSecao>
      <ul class="mt-8 grid gap-4 text-sal sm:grid-cols-2">
        {
          config.comodidades.map((comodidade) => (
            <li class="flex gap-3">
              <span class="mt-2.5 h-0.5 w-4 shrink-0 bg-fitinha" aria-hidden="true" />
              {comodidade.nome}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-14 text-center">
    <h2 class="font-display text-3xl font-bold text-mare">Reserve direto com a gente</h2>
    <p class="mx-auto mt-3 max-w-md">
      Sem comissão de plataforma: chame no WhatsApp e combine sua estadia direto com quem cuida da
      casa.
    </p>
    <div class="mt-6">
      <BotaoWhatsApp tamanho="grande" />
    </div>
  </section>
</Layout>
