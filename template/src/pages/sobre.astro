---
import Layout from '../layouts/Layout.astro';
import TituloSecao from '../components/TituloSecao.astro';
import { config } from '../lib/cliente';
---

<Layout titulo="Sobre">
  <section class="mx-auto max-w-5xl px-4 py-14">
    <TituloSecao eyebrow="Sobre">Nossa história</TituloSecao>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed">{config.sobre.historia}</p>
  </section>

  <section class="bg-sal">
    <div class="mx-auto max-w-5xl px-4 py-14">
      <TituloSecao eyebrow="Diferenciais">Por que ficar aqui</TituloSecao>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2">
        {
          config.sobre.diferenciais.map((diferencial) => (
            <li class="flex gap-3 rounded-xl bg-white p-4 shadow-sm">
              <span class="mt-2.5 h-0.5 w-4 shrink-0 bg-fitinha" aria-hidden="true" />
              {diferencial}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
